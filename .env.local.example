# Configuration Sanity
# Ces variables sont publiques et peuvent être exposées côté client

# ID du projet Sanity (trouvé dans studio-perso/sanity.config.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=65s5qkds

# Dataset Sanity (production par défaut)
NEXT_PUBLIC_SANITY_DATASET=production

# Version de l'API Sanity
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# URL de base pour l'API (optionnel, pour la rétrocompatibilité)
NEXT_PUBLIC_API_URL=
