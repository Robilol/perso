# Sanity — valeurs publiques ; à défaut, celles de sanity/env.ts sont utilisées
NEXT_PUBLIC_SANITY_PROJECT_ID=65s5qkds
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Secret partagé avec le webhook Sanity qui régénère les pages à chaque publication
# (sans webhook, les pages se mettent à jour au plus tard toutes les heures)
SANITY_REVALIDATE_SECRET=

# URL publique du site : canonical, sitemap et Open Graph
NEXT_PUBLIC_SITE_URL=https://www.robin-regis.fr

# Formulaire de contact — envoi par la route /api/contact avec Resend (https://resend.com/api-keys)
# Tant que RESEND_API_KEY est vide, le formulaire passe par EmailJS depuis le navigateur.
RESEND_API_KEY=
# Clé secrète reCAPTCHA v3 associée à la clé de site (https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=
# Destinataire (par défaut : l'email du profil Sanity)
CONTACT_TO_EMAIL=
# Expéditeur, sur un domaine vérifié dans Resend (par défaut : Portfolio <onboarding@resend.dev>,
# qui ne peut écrire qu'à l'adresse du compte Resend)
CONTACT_FROM_EMAIL=

# Clés publiques — optionnelles, valeurs par défaut dans lib/recaptcha.ts et components/contact/send-message.ts
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
